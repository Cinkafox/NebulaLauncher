<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:popup="clr-namespace:Nebula.Launcher.ViewModels.Popup"
             xmlns:services="clr-namespace:Nebula.Launcher.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Nebula.Launcher.Views.Popup.PrivacyInfoView"
             x:DataType="popup:PrivacyInfoViewModel">
    <Design.DataContext>
        <popup:PrivacyInfoViewModel />
    </Design.DataContext>
    <Grid RowDefinitions="40,40,40,40" ColumnDefinitions="*,*" ColumnSpacing="5" RowSpacing="5">
        <TextBlock 
            VerticalAlignment="Center"
            HorizontalAlignment="Center" 
            Grid.ColumnSpan="2" 
            Text="{services:LocaledText privacy-info-popup-info}"/>
        
        <Border Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0"  Background="{StaticResource DefaultSelected}" BoxShadow="{StaticResource DefaultShadow}">
            <Button HorizontalAlignment="Stretch" Command="{Binding GoToPrivacy}">
                <TextBlock HorizontalAlignment="Center" Text="{services:LocaledText privacy-info-popup-read}"/>
            </Button>
        </Border>
        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource DefaultSelected}" BoxShadow="{StaticResource DefaultShadow}">
            <Button HorizontalAlignment="Stretch" Command="{Binding Accept}">
                <TextBlock HorizontalAlignment="Center" Text="{services:LocaledText privacy-info-popup-accept}"/>
            </Button>
        </Border>
        <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource DefaultSelected}" BoxShadow="{StaticResource DefaultShadow}">
            <Button HorizontalAlignment="Stretch" Command="{Binding Decline}">
                <TextBlock HorizontalAlignment="Center" Text="{services:LocaledText privacy-info-popup-decline}"/>
            </Button>
        </Border>
    </Grid>
</UserControl>
